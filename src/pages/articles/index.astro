---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import Text from '../../components/Text.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getContentPairs, categories } from '../../data/content';
const pairs = await getContentPairs('articles');
const usedCategories = Object.entries(categories).filter(([key]) => pairs.some((pair) => pair.zh.data.category === key));
const title = { zh: '笔记', en: 'Notes' };
const description = { zh: '游戏分析和开发笔记。', en: 'Game analysis and development notes.' };
---
<PortfolioLayout title={title} description={description}>
	<header class="page-intro"><Text as="h1" {...title} /><Text as="p" class="page-description" {...description} /></header>
	<div class="category-filters" role="group" aria-label="文章分类" data-i18n-inline-aria-label data-zh="文章分类" data-en="Article categories">
		<button type="button" data-filter="all" aria-pressed="true"><Text zh="全部" en="All" /></button>
		{usedCategories.map(([key, label]) => <button type="button" data-filter={key} aria-pressed="false"><Text {...label} /></button>)}
	</div>
	<div class="reading-grid" data-filter-list>{pairs.map((pair) => <ContentCard pair={pair} />)}</div>
	<script>
		document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.filter;
				document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((item) => {
					item.setAttribute('aria-pressed', String(item === button));
				});

				document.querySelectorAll<HTMLElement>('[data-filter-list] [data-category]').forEach((card) => {
					card.hidden = filter !== 'all' && card.dataset.category !== filter;
				});
			});
		});
	</script>
</PortfolioLayout>
