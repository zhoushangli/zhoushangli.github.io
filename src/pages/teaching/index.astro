---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import Text from '../../components/Text.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getContentPairs, teachingOrder } from '../../data/content';
const pairs = await getContentPairs('teaching');
pairs.sort((a, b) => teachingOrder.indexOf(a.zh.data.contentId) - teachingOrder.indexOf(b.zh.data.contentId));
const title = { zh: '教学', en: 'Teaching' };
const description = { zh: 'Pico8 入社培训与 Gamejam 作品展。', en: 'PICO-8 training for new members and a game jam showcase.' };
---
<PortfolioLayout title={title} description={description}>
	<header class="page-intro"><Text as="h1" {...title} /><Text as="p" class="page-description" {...description} /></header>
	<div class="reading-grid">{pairs.map((pair) => <ContentCard pair={pair} />)}</div>
</PortfolioLayout>
