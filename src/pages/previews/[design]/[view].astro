---
import { conceptIds, views, concepts } from '../../../data/preview';
import type { DesignRecord } from '../../../data/design-types';
import { getDesignContent } from '../../../data/design-content';
import LegacyPreview from '../../../components/previews/LegacyPreview.astro';
import DesignA from '../../../components/previews/DesignA.astro';
import DesignB from '../../../components/previews/DesignB.astro';
import DesignC from '../../../components/previews/DesignC.astro';
import DesignD from '../../../components/previews/DesignD.astro';
import DesignE from '../../../components/previews/DesignE.astro';
import DesignF from '../../../components/previews/DesignF.astro';
import '../../../styles/designs/design-a.css';
import '../../../styles/designs/design-b.css';
import '../../../styles/designs/design-c.css';
import '../../../styles/designs/design-d.css';
import '../../../styles/designs/design-e.css';
import '../../../styles/designs/design-f.css';

export function getStaticPaths() {
  return conceptIds.flatMap((design) => views.map((view) => ({ params: { design, view } })));
}

const { design, view } = Astro.params;
const base = '/previews/' + design;
const pages = { 'design-a': DesignA, 'design-b': DesignB, 'design-c': DesignC, 'design-d': DesignD, 'design-e': DesignE, 'design-f': DesignF };
const DesignPage = pages[design as keyof typeof pages];
if (DesignPage && view === 'category') {
  return Astro.redirect(base + '/articles');
}
const data = DesignPage ? await getDesignContent() : null;
---
{DesignPage && data ? <DesignPage concept={concepts[design!] as DesignRecord} view={view as 'home' | 'articles' | 'article'} base={base} data={data} /> : <LegacyPreview />}
