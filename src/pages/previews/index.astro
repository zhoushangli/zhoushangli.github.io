---
import { concepts } from '../../data/preview';

const designIds = Object.keys(concepts).filter((id) => id.startsWith('design-'));

const gateModules = import.meta.glob('../../data/preview-audit/*.gates.json', { eager: true }) as Record<string, { default: any }>;
const scoreModules = import.meta.glob('../../data/preview-audit/*.score.json', { eager: true }) as Record<string, { default: any }>;

const readById = (modules: Record<string, { default: any }>, suffix: string) => {
  const map: Record<string, any> = {};
  for (const [path, module] of Object.entries(modules)) {
    map[path.split('/').pop()!.replace(suffix, '')] = module.default;
  }
  return map;
};

const gatesById = readById(gateModules, '.gates.json');
const scoresById = readById(scoreModules, '.score.json');

const axisOrder = ['imagery', 'layout', 'typography', 'accent', 'mechanism', 'rhythm'] as const;
const axisLabels: Record<string, string> = {
  imagery: '意象域',
  layout: '布局原型',
  typography: '字体策略',
  accent: '强调色关系',
  mechanism: '主视觉机制',
  rhythm: '节奏',
};
const scoreOrder = ['reading', 'structure', 'creativity', 'darkSystem', 'mobile'] as const;
const scoreLabels: Record<string, string> = {
  reading: '中文长文阅读',
  structure: '信息结构与可扩展性',
  creativity: '视觉创意与记忆点',
  darkSystem: '暗色体系完成度',
  mobile: '移动端与状态',
};
const scoreMax: Record<string, number> = { reading: 25, structure: 25, creativity: 20, darkSystem: 15, mobile: 15 };
const views = ['home', 'articles', 'category', 'article'] as const;
const viewLabels: Record<string, string> = { home: '首页', articles: '文章列表', category: '分类', article: '文章详情' };

const cards = designIds.map((id) => {
  const concept = concepts[id];
  const gates = gatesById[id] ?? null;
  const score = scoresById[id] ?? null;
  const scores = score?.scores ?? null;
  const total = scores ? scoreOrder.reduce((sum, key) => sum + (scores[key] ?? 0), 0) : null;
  const gateMap = gates?.gates ?? null;
  const failedGates = gateMap ? Object.entries(gateMap).filter(([, value]) => !value).map(([key]) => key) : [];
  return {
    id,
    label: concept.label ?? '?',
    name: concept.name,
    english: concept.english,
    seed: concept.seed,
    idea: concept.idea,
    device: concept.device ?? '待设计',
    axes: axisOrder.map((key) => ({ key, label: axisLabels[key], value: concept.axes?.[key] ?? '?' })),
    thumb: gates?.thumbnails?.home?.path ?? null,
    round: gates?.round ?? null,
    gatesReady: Boolean(gateMap),
    failedGates,
    scores: scoreOrder.map((key) => ({ key, label: scoreLabels[key], value: scores?.[key] ?? null, max: scoreMax[key] })),
    total,
    verdict: score?.verdict ?? null,
    defects: (score?.defects ?? []).slice(0, 3),
  };
});

const qualified = cards.filter((card) => card.verdict === 'pass' && (card.total ?? 0) >= 80).length;
const scored = cards.filter((card) => card.total !== null).length;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="暗色博客设计候选方案对比总览" />
    <title>设计方案对比 · 周尚礼</title>
  </head>
  <body>
    <header class="top">
      <p class="eyebrow">DESIGN ROUND / 六案对比</p>
      <h1>暗色博客候选设计</h1>
      <p class="lede">
        每套设计由随机种子派生六个设计轴，覆盖首页、文章列表、分类与文章详情四个视图，共用同一份演示数据，因此可以直接横向比较。
        评分采用 100 分制五维表，合格线为总分 ≥ 80、中文长文阅读 ≥ 20、移动端 ≥ 12，同时必须通过全部硬门槛。
      </p>
      <dl class="stats">
        <div><dt>候选</dt><dd>{cards.length}</dd></div>
        <div><dt>已评分</dt><dd>{scored}</dd></div>
        <div><dt>已合格</dt><dd>{qualified} / {cards.length}</dd></div>
        <div><dt>评审轮次上限</dt><dd>3 轮 / 槽</dd></div>
      </dl>
    </header>

    <main class="grid">
      {cards.map((card) => (
        <article class:list={['card', { passed: card.verdict === 'pass' }]}>
          <div class="card-head">
            <span class="slot">方案 {card.label}</span>
            <div class="titles">
              <h2>{card.name}</h2>
              <p class="english">{card.english}</p>
            </div>
            <span class:list={['badge', { ok: card.verdict === 'pass', pending: !card.verdict }]}>
              {card.verdict === 'pass' ? `合格 ${card.total}` : card.verdict === 'fail' ? `未过线 ${card.total}` : '评审中'}
            </span>
          </div>

          <a class="thumb" href={`/previews/${card.id}/home`}>
            {card.thumb ? <img src={card.thumb} alt={`${card.name} 首页缩略图`} loading="lazy" /> : <span>尚未截图 · 等待首次评审</span>}
          </a>

          <p class="device"><span>记忆点</span>{card.device}</p>
          <p class="idea">{card.idea}</p>
          <p class="seed">SEED / <code>{card.seed}</code>{card.round ? ` · ROUND ${card.round}` : ''}</p>

          <ul class="axes">
            {card.axes.map((axis) => (
              <li><span>{axis.label}</span><b>{axis.value}</b></li>
            ))}
          </ul>

          <div class="scores">
            {card.scores.map((row) => (
              <div class="score">
                <span class="score-label">{row.label}</span>
                <span class="bar"><i style={`width:${row.value === null ? 0 : Math.round((row.value / row.max) * 100)}%`}></i></span>
                <span class="score-value">{row.value === null ? '–' : `${row.value}/${row.max}`}</span>
              </div>
            ))}
          </div>

          <div class="gates">
            <span>硬门槛</span>
            {card.gatesReady && card.failedGates.length === 0 ? <b class="ok">全部通过</b> : card.gatesReady ? <b class="bad">未通过：{card.failedGates.join('、')}</b> : <b class="pending">未检测</b>}
          </div>

          {card.defects.length > 0 && (
            <ul class="defects">
              {card.defects.map((defect: string) => <li>{defect}</li>)}
            </ul>
          )}

          <nav class="links">
            {views.map((view) => <a href={`/previews/${card.id}/${view}`}>{viewLabels[view]}</a>)}
          </nav>
        </article>
      ))}
    </main>

    <footer class="bottom">
      <p>上一轮的 observatory / arcade / atlas 仍可访问，但不参与本次评选。</p>
      <p><a href="/">← 返回正式网站</a></p>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background: #0b0c0e;
    color: #e9ebef;
    font-family: 'Microsoft YaHei', 'PingFang SC', 'Hiragino Sans GB', system-ui, sans-serif;
    line-height: 1.75;
  }
  .top { padding: 68px max(4vw, 24px) 34px; border-bottom: 1px solid #212429; }
  .eyebrow { margin: 0 0 22px; font-size: 12px; letter-spacing: .26em; text-transform: uppercase; color: #8d94a0; }
  h1 { margin: 0; font-size: clamp(34px, 4.4vw, 62px); letter-spacing: -.05em; line-height: 1.16; }
  .lede { max-width: 880px; margin: 24px 0 0; color: #a7adb8; font-size: 16px; }
  .stats { display: flex; flex-wrap: wrap; gap: 42px; margin: 38px 0 0; }
  .stats div { margin: 0; }
  .stats dt { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #7d838e; }
  .stats dd { margin: 6px 0 0; font-size: 24px; font-variant-numeric: tabular-nums; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(430px, 1fr)); gap: 26px; padding: 34px max(4vw, 24px) 60px; }
  .card { display: flex; flex-direction: column; gap: 16px; padding: 24px; border: 1px solid #23262c; background: #101215; }
  .card.passed { border-color: #3c4a3f; }
  .card-head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: 16px; }
  .slot { padding: 5px 9px; border: 1px solid #33373f; font-size: 12px; letter-spacing: .12em; color: #c3c8d1; white-space: nowrap; }
  .titles h2 { margin: 0; font-size: 22px; letter-spacing: -.02em; }
  .english { margin: 4px 0 0; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: #7d838e; }
  .badge { padding: 5px 9px; font-size: 12px; border: 1px solid #3a3f47; color: #b9bfc9; white-space: nowrap; }
  .badge.ok { border-color: #4d6b53; color: #a8d6b0; }
  .badge.pending { border-color: #3a3f47; color: #8d94a0; }
  .thumb { display: flex; align-items: center; justify-content: center; min-height: 190px; border: 1px solid #23262c; background: #0c0e10; overflow: hidden; }
  .thumb img { width: 100%; display: block; }
  .thumb span { color: #6c727c; font-size: 13px; }
  .device { margin: 0; font-size: 15px; }
  .device span { display: inline-block; margin-right: 10px; padding: 2px 7px; border: 1px solid #3a3f47; font-size: 11px; letter-spacing: .12em; color: #9aa1ac; }
  .idea { margin: 0; color: #9aa1ac; font-size: 14px; }
  .seed { margin: 0; font-size: 12px; color: #7d838e; }
  .seed code { font-family: Consolas, 'Courier New', monospace; color: #c3c8d1; }
  .axes { display: grid; gap: 0; margin: 4px 0 0; padding: 0; list-style: none; border-top: 1px solid #212429; }
  .axes li { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 7px 0; border-bottom: 1px solid #1c1f24; font-size: 13px; }
  .axes span { color: #7d838e; }
  .axes b { font-weight: 500; color: #d7dbe2; }
  .scores { display: grid; gap: 7px; margin-top: 4px; }
  .score { display: grid; grid-template-columns: 140px minmax(0, 1fr) 52px; align-items: center; gap: 12px; font-size: 12px; color: #9aa1ac; }
  .bar { height: 5px; background: #1d2026; display: block; }
  .bar i { display: block; height: 100%; background: #6f7b8c; }
  .score-value { text-align: right; font-variant-numeric: tabular-nums; color: #c3c8d1; }
  .gates { display: flex; align-items: baseline; gap: 12px; font-size: 13px; color: #7d838e; }
  .gates .ok { color: #a8d6b0; font-weight: 500; }
  .gates .bad { color: #e0a3a3; font-weight: 500; }
  .gates .pending { color: #8d94a0; font-weight: 500; }
  .defects { margin: 0; padding-left: 18px; color: #c9a9a9; font-size: 13px; }
  .links { display: flex; flex-wrap: wrap; gap: 16px; margin-top: auto; padding-top: 8px; border-top: 1px solid #212429; font-size: 13px; }
  .links a { color: #cfd4dc; text-decoration: none; border-bottom: 1px solid currentColor; }
  .bottom { padding: 26px max(4vw, 24px) 50px; border-top: 1px solid #212429; color: #7d838e; font-size: 13px; }
  .bottom p { margin: 4px 0; }
  .bottom a { color: #cfd4dc; }
</style>
