---
import { concepts } from '../../data/preview';
const ids = Object.keys(concepts).filter((id) => id.startsWith('design-'));
const modules = import.meta.glob('../../data/preview-audit/*.json', { eager: true }) as Record<string, { default: any }>;
const lookup = (file: string) => Object.entries(modules).find(([path]) => path.endsWith('/' + file))?.[1].default;
const comparison = lookup('comparison.json');
const dimensions = [{ key:'aesthetics', label:'美术表现', max:25 }, { key:'reading', label:'中文阅读', max:25 }, { key:'structure', label:'信息组织', max:20 }, { key:'diversity', label:'创意与差异', max:15 }, { key:'mobile', label:'移动与交互', max:15 }];
const cards = ids.map((id) => {
  const concept = concepts[id];
  const gates = lookup(id + '.gates.json');
  const score = lookup(id + '.score.json');
  const current = score && gates && score.round === gates.round;
  const total = current ? dimensions.reduce((sum, dim) => sum + (score.scores?.[dim.key] || 0), 0) : null;
  const failed = gates ? Object.entries(gates.gates).filter(([, pass]) => pass !== true).map(([key]) => key) : [];
  const compared = comparison?.pairs?.filter((pair: any) => pair.left === id || pair.right === id) ?? [];
  const crossPass = compared.length === 5 && compared.every((pair: any) => pair.layoutDifferent && pair.interactionDifferent && pair.differentAxes?.length >= 4 && pair.rounds?.[id] === gates?.round);
  const passed = current && score.verdict === 'pass' && gates?.allGatesPass && failed.length === 0 && total >= 80 && score.scores.aesthetics >= 20 && score.scores.reading >= 20 && score.scores.diversity >= 12 && score.scores.mobile >= 12 && crossPass;
  return { id, concept, gates, score:current ? score : null, total, failed, passed, crossPass };
});
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>六种夜色 · 暗色古典博客设计对比</title>
  <meta name="description" content="六套暗色古典博客方向：首页、文章索引与阅读页，附独立评审和桌面手机预览。" />
</head>
<body>
  <header class="overview-head">
    <div class="topline"><a href="/">周尚礼 · 博客与作品集 ↗</a><span>DESIGN STUDIES / 2026</span></div>
    <p class="eyebrow">SIX WAYS TO READ THE NIGHT</p><h1>六种夜色，<br /><em>六种阅读世界的方式。</em></h1>
    <p class="intro">同一份真实内容，六种美术语言。每套包含首页、文章索引与文章阅读，探索古典的秩序与当代的表达。</p>
    <div class="summary"><span><b>06</b> 设计方向</span><span><b>18</b> 展示页面</span><span><b>{cards.filter((card) => card.passed).length} / 6</b> 独立评审合格</span><a href="#standards">查看评审标准 ↓</a></div>
  </header>
  <main>
    <div class="overview-grid">{cards.map(({ id, concept, gates, score, total, failed, passed, crossPass }) => <article class="design-card">
      <header class="card-head"><div><span class="letter">{concept.label}</span><span class="english">{concept.english}</span><h2>{concept.name}</h2></div><span class:list={['badge', { passed }]}>{passed ? '合格 · ' + total : score?.verdict === 'fail' || failed.length ? '待改进' : '待独立评审'}</span></header>
      <a class="preview-pair" href={'/previews/' + id + '/home'} aria-label={'浏览' + concept.name + '首页'}>
        {gates ? <><img class="desktop-thumb" src={'/previews-audit/' + id + '-desktop.webp'} alt={concept.name + '桌面首页截图'} width="1440" height="900" loading="lazy" /><img class="mobile-thumb" src={'/previews-audit/' + id + '-mobile.webp'} alt={concept.name + '手机首页截图'} width="390" height="844" loading="lazy" /></> : <span>首次截图准备中</span>}
      </a>
      <p class="idea">{concept.idea}</p>
      <dl class="axes"><div><dt>布局</dt><dd>{concept.axes?.layout}</dd></div><div><dt>交互</dt><dd>{concept.axes?.mechanism}</dd></div><div><dt>色彩</dt><dd>{concept.axes?.accent}</dd></div><div><dt>节奏</dt><dd>{concept.axes?.rhythm}</dd></div></dl>
      <nav class="view-links" aria-label={concept.name + '页面入口'}><a href={'/previews/' + id + '/home'}>首页 ↗</a><a href={'/previews/' + id + '/articles'}>文章索引 ↗</a><a href={'/previews/' + id + '/article'}>文章阅读 ↗</a></nav>
      <div class="scorecard">{dimensions.map((dim) => <div><span>{dim.label}</span><i><b style={'width:' + (score ? score.scores[dim.key] / dim.max * 100 : 0) + '%'}></b></i><span>{score ? score.scores[dim.key] : '—'} / {dim.max}</span></div>)}</div>
      <div class="audit-line"><span>{gates ? '技术检查：' + (gates.allGatesPass ? '通过' : '未通过') : '技术检查：待检测'}</span><span>横向差异：{crossPass ? '通过' : '待评审'}</span><span>第 {gates?.round ?? '—'} 轮</span></div>
      {score && <p class="verdict">{score.summary}</p>}
      {score?.defects?.length > 0 && <details><summary>评审记录 / {score.defects.length} 条</summary><ul>{score.defects.map((defect: string) => <li>{defect}</li>)}</ul></details>}
      {failed.length > 0 && <p class="failed">未过门槛：{failed.join('、')}</p>}
      {score && <a class="report-link" href={'/previews-audit/' + id + '-review.json'}>查看评审与检查依据 ↗</a>}
    </article>)}</div>
    <section id="standards" class="standards"><p class="eyebrow">THE REVIEW</p><h2>好看，也要经得起阅读。</h2><p>合格要求总分至少 80，美术与阅读各至少 20，创意差异与移动交互各至少 12，且通过全部技术门槛。每两案至少四个设计维度不同，必须包含布局和主要交互。另一位 agent 根据实际截图与浏览器交互证据独立评审。</p><p>测试覆盖 1440 / 1024 / 390px，包含真实长文、图片、代码、分类、键盘操作和临时注入的长标题与宽表格。截图与评分按轮次归档；未验证的项目不能计为通过。</p><p>这些页面用于选择设计方向。其他文章与项目入口已标明会前往正式页面。</p><a href="/previews-audit/summary.md">完整评审汇总 ↗</a></section>
  </main>
  <footer>历史原型：<a href="/previews/observatory/home">Observatory</a><a href="/previews/arcade/home">Arcade</a><a href="/previews/atlas/home">Atlas</a><span>© 2026 周尚礼</span></footer>
</body>
</html>
<style>
  * { box-sizing:border-box; }
  html { color-scheme:dark; scroll-behavior:smooth; }
  body { margin:0; background:#121416; color:#ede8df; font:15px/1.9 'Microsoft YaHei','PingFang SC',system-ui,sans-serif; }
  a { color:inherit; text-decoration:none; }
  a:hover { color:#dbbd92; }
  a:focus-visible,summary:focus-visible { outline:2px solid #dbbd92; outline-offset:4px; }
  h1,h2,p { margin:0; }
  .overview-head { padding:30px 5vw 48px; border-bottom:1px solid #34383c; }
  .topline { display:flex; justify-content:space-between; gap:20px; color:#bcbab4; font-size:12px; margin-bottom:65px; }
  .topline a { min-height:44px; display:flex; align-items:center; }
  .topline > span { padding-top:10px; letter-spacing:.14em; }
  .eyebrow { font:12px/1.8 Georgia,serif; letter-spacing:.2em; color:#c3b395; margin-bottom:24px; }
  h1 { font:400 clamp(34px,4.2vw,62px)/1.5 'Songti SC','SimSun',Georgia,serif; }
  h1 em { color:#d2bc9c; font-style:normal; }
  .intro { max-width:650px; color:#bbb9b3; margin-top:26px; font-size:16px; }
  .summary { display:flex; gap:40px; align-items:center; flex-wrap:wrap; margin-top:45px; font-size:12px; color:#c0bcb4; }
  .summary b { font:28px Georgia,serif; color:#eee8dc; display:block; margin-bottom:10px; }
  .summary > a { margin-left:auto; min-height:44px; display:flex; align-items:center; }
  .overview-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:36px; padding:48px 5vw 70px; }
  .design-card { border:1px solid #363a3d; background:#181b1d; padding:27px; min-width:0; }
  .card-head { display:flex; gap:15px; justify-content:space-between; align-items:start; margin-bottom:25px; }
  .letter { display:inline-block; color:#d2bc9c; font:italic 23px Georgia,serif; margin-right:18px; }
  .english { font:10px Georgia,serif; letter-spacing:.12em; color:#b6b6af; }
  h2 { font:400 30px/1.6 'Songti SC','SimSun',Georgia,serif; margin-top:10px; }
  .badge { border:1px solid #68615a; color:#d7c6ad; font-size:11px; padding:5px 9px; white-space:nowrap; }
  .badge.passed { color:#c2d0b7; border-color:#5c6a50; }
  .preview-pair { display:flex; gap:12px; align-items:start; background:#0d1013; padding:12px; min-height:160px; border:1px solid #34383c; }
  .preview-pair img { display:block; height:auto; min-width:0; }
  .desktop-thumb { width:76%; }
  .mobile-thumb { width:21%; border:1px solid #44484b; }
  .idea { margin:24px 0; color:#c2beb5; font-size:14px; }
  .axes { margin:0; }
  .axes > div { display:grid; grid-template-columns:45px minmax(0,1fr); gap:12px; padding:9px 0; border-top:1px solid #303538; font-size:12px; }
  dt { color:#b4b2aa; } dd { margin:0; color:#dfd8ce; }
  .view-links { display:flex; flex-wrap:wrap; gap:20px; margin:22px 0; border-top:1px solid #363a3d; border-bottom:1px solid #363a3d; }
  .view-links a { min-height:48px; display:flex; align-items:center; font-size:13px; }
  .scorecard { display:grid; gap:8px; }
  .scorecard > div { display:grid; grid-template-columns:100px minmax(0,1fr) 50px; gap:12px; align-items:center; font-size:11px; color:#c3bfb6; }
  .scorecard i { background:#303538; height:3px; }
  .scorecard b { display:block; background:#c3b395; height:3px; }
  .scorecard > div > span:last-child { text-align:right; }
  .audit-line { display:flex; flex-wrap:wrap; gap:12px; margin:22px 0 0; color:#bbb6aa; font-size:11px; }
  .verdict { font-size:13px; color:#d4ccbc; margin-top:16px; }
  details { font-size:12px; color:#c0b9aa; margin-top:14px; }
  summary { cursor:pointer; min-height:44px; padding:10px 0; }
  ul { padding-left:18px; }
  .failed { color:#ecc0b0; font-size:12px; margin-top:15px; overflow-wrap:anywhere; }
  .report-link { display:inline-flex; min-height:44px; align-items:center; color:#c3b395; font-size:12px; margin-top:12px; }
  .standards { border-top:1px solid #34383c; padding:60px 5vw; }
  .standards p { max-width:850px; color:#bcb7ad; margin:22px 0; }
  .standards a { display:inline-flex; min-height:44px; align-items:center; color:#d2bc9c; }
  footer { display:flex; flex-wrap:wrap; gap:20px; border-top:1px solid #34383c; padding:25px 5vw; color:#bab7b0; font-size:12px; align-items:center; }
  footer a { min-height:44px; display:flex; align-items:center; }
  footer span { margin-left:auto; }
  @media(max-width:850px) { .overview-grid { grid-template-columns:1fr; } }
  @media(max-width:500px) { .overview-head { padding:22px; } .topline { flex-wrap:wrap; gap:4px; margin-bottom:40px; } h1 { font-size:32px; } .summary { gap:25px; } .summary > a { margin-left:0; } .overview-grid { padding:30px 18px; gap:24px; } .design-card { padding:20px; } .card-head { flex-wrap:wrap; } h2 { font-size:27px; } .english { font-size:9px; } .preview-pair { gap:8px; padding:8px; } .view-links { gap:16px; } .view-links a { font-size:12px; } .standards { padding:40px 22px; } }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
</style>
