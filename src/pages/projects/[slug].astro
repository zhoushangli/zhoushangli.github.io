---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import Text from '../../components/Text.astro';
import ContentCard from '../../components/ContentCard.astro';
import { projects } from '../../data/projects';
import { getContentPairs } from '../../data/content';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const articles = (await getContentPairs('articles')).filter((pair) => project.relatedArticles?.includes(pair.zh.data.contentId));
const title = { zh: `${project.title} · 作品`, en: `${project.title} · Projects` };
const duration = project.duration
  ? { zh: project.duration.replace('Present', '至今'), en: project.duration }
  : undefined;
---
<PortfolioLayout title={title} description={project.summary}>
  <header class="page-intro project-intro">
    <a href="/projects/"><Text zh="← 作品" en="← Projects" /></a>
    <Text as="p" class="eyebrow" zh={project.category === 'personal' ? '个人项目' : '团队项目'} en={project.category === 'personal' ? 'Personal project' : 'Team project'} />
    <h1>{project.title}</h1><Text as="p" class="page-description" {...project.summary} /><Text as="p" class="showcase-tech" {...project.tech} />
    <div class="page-links">{project.externalLink && <a href={project.externalLink.href} target="_blank" rel="noreferrer"><Text {...project.externalLink.label} /></a>}{project.downloads?.map((download) => <a href={download.href}><Text {...download.label} /></a>)}</div>
  </header>
  <figure class="project-detail-media">
    <img src={project.media.src} alt={project.media.alt.zh} data-i18n-inline-alt data-zh={project.media.alt.zh} data-en={project.media.alt.en} />
    {project.media.caption && <Text as="figcaption" class="caption" {...project.media.caption} />}
  </figure>
  <section class="section project-notes">
    <dl>
      {project.platform && <div><Text as="dt" zh="平台" en="Platform" /><Text as="dd" {...project.platform} /></div>}
      {project.status && <div><Text as="dt" zh="项目状态" en="Status" /><Text as="dd" {...project.status} /></div>}
      {duration && <div><Text as="dt" zh="开发时间" en="Development period" /><Text as="dd" {...duration} /></div>}
      {project.role && <div><Text as="dt" zh="我的职责" en="My role" /><Text as="dd" {...project.role} /></div>}
    </dl>
    <Text as="h2" zh="项目介绍" en="Overview" /><Text as="p" {...project.detail} />
    {project.category === 'team' && <><Text as="h2" zh="我的工作" en="My work" /><Text as="p" {...project.contribution} /></>}
    {project.designNotes?.length > 0 && <div class="project-design">
      <Text as="h2" zh="策划与关卡" en="Game and level design" />
      {project.designNotes.map((note) => <><Text as="h3" {...note.title} /><Text as="p" {...note.body} /></>)}
    </div>}
    {project.renderingNotes?.length > 0 && <div class="project-rendering">
      <Text as="h2" zh="自定义渲染管线" en="Custom rendering pipeline" />
      {project.renderingNotes.map((note) => <><Text as="h3" {...note.title} /><Text as="p" {...note.body} /></>)}
    </div>}
    {project.features?.length > 0 && <><Text as="h2" zh={project.renderingNotes?.length ? '其他程序工作' : project.designNotes?.length ? '程序与技术美术' : '主要功能'} en={project.renderingNotes?.length ? 'Other programming work' : project.designNotes?.length ? 'Programming and technical art' : 'Features'} /><ul>{project.features.map((feature) => <Text as="li" {...feature} />)}</ul></>}
    {project.decisions?.length > 0 && <><Text as="h2" zh="实现" en="Implementation" /><ul>{project.decisions.map((decision) => <Text as="li" {...decision} />)}</ul></>}
    {project.limitations?.length > 0 && <><Text as="h2" zh="开发进展" en="Development notes" /><ul>{project.limitations.map((limit) => <Text as="li" {...limit} />)}</ul></>}
  </section>
  {project.embedVideo && <section class="section"><Text as="h2" zh="项目演示" en="Project demonstration" /><div class="video-frame"><iframe src={project.embedVideo.src} title={project.embedVideo.title.zh} data-i18n-inline-title data-zh={project.embedVideo.title.zh} data-en={project.embedVideo.title.en} loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen /></div></section>}
  {articles.length > 0 && <section class="section"><Text as="h2" zh="相关专题" en="Related studies" /><div class="reading-grid">{articles.map((pair) => <ContentCard pair={pair} />)}</div></section>}
  {project.developmentLogs?.length > 0 && <section class="section">
    <Text as="h2" zh="开发记录" en="Development logs" />
    <div class="development-logs">{project.developmentLogs.map((log) => <a href={log.href} target="_blank" rel="noreferrer">
      <time datetime={log.date}>{log.date.slice(5).replace('-', '.')}</time>
      <Text class="log-title" {...log.label} />
      <span class="log-arrow" aria-hidden="true">↗</span>
    </a>)}</div>
  </section>}
</PortfolioLayout>
