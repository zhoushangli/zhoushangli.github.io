---
import { Image } from 'astro:assets';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import Text from '../components/Text.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContentCard from '../components/ContentCard.astro';
import HeroImage from '../content/images/hero_image.jpg';
import DesktopImage from '../content/images/desktop.jpg';
import TencentImage from '../content/images/tencent.png';
import NuverseImage from '../content/images/nuverse.png';
import ShanghaiTechImage from '../content/images/shanghaitech.png';
import SmuImage from '../content/images/smu.png';
import { getProjectsByCategory } from '../data/projects';
import { getContentPairs } from '../data/content';
const articles = await getContentPairs('articles');
const teaching = await getContentPairs('teaching');
const selectedArticles = ['ming-csharp-bridge', 'spectrex-light-gameplay', 'animal-well-rendering'].map((id) => articles.find((pair) => pair.zh.data.contentId === id)).filter(Boolean);
const selectedTeaching = ['pico8-2026', 'pico8-game-jam'].map((id) => teaching.find((pair) => pair.zh.data.contentId === id)).filter(Boolean);
const experiences = [
  { image: TencentImage, name: { zh: '腾讯魔方工作室群', en: 'Tencent MoreFun Studios' }, date: { zh: '2024 年 1—2 月', en: 'Jan–Feb 2024' }, role: { zh: '战斗策划实习生', en: 'Combat designer intern' }, description: { zh: '参与游戏音效配置和敌人战斗动画配置，在团队制作流程中理解战斗表现与玩法反馈的关系。', en: 'Configured in-game audio and enemy combat animations, learning how combat presentation and gameplay feedback connect within a team production pipeline.' }, tech: { zh: '战斗策划 · 音效配置 · 敌人动画', en: 'Combat design · Audio configuration · Enemy animation' } },
  { image: NuverseImage, name: { zh: '朝夕光年', en: 'Nuverse' }, date: { zh: '2023 年 8—12 月', en: 'Aug–Dec 2023' }, role: { zh: '软件开发实习生', en: 'Software development intern' }, description: { zh: '使用 PyQt 参与引擎工具链的界面开发，支持开发工具与制作流程。', en: 'Contributed PyQt interfaces to an engine toolchain, supporting development tools and production workflows.' }, tech: { zh: 'PyQt · 工具链 · 界面开发', en: 'PyQt · Toolchains · UI development' } },
];
const education = [
  { image: SmuImage, name: { zh: 'SMU Guildhall', en: 'SMU Guildhall' }, date: { zh: '2025—2027 · 预计 2027 年 5 月毕业', en: '2025–2027 · Expected graduation: May 2027' }, role: { zh: '游戏开发研究生课程 · 程序方向', en: 'Graduate study in game development · Programming' }, description: { zh: '关注引擎编程、玩法系统与团队制作实践，同时通过游戏社课程分享开发经验。', en: 'Studying engine programming, gameplay systems and team production while sharing development experience through game-club teaching.' }, tech: { zh: 'C++ · Direct3D 11 · 游戏制作', en: 'C++ · Direct3D 11 · Game production' } },
  { image: ShanghaiTechImage, name: { zh: '上海科技大学', en: 'ShanghaiTech University' }, date: { zh: '2021—2025', en: '2021–2025' }, role: { zh: '计算机科学本科', en: 'Undergraduate study in computer science' }, description: { zh: '建立程序设计、计算机系统与软件开发基础，并通过独立游戏实践探索交互与关卡设计。', en: 'Built a foundation in programming, computer systems and software development, and explored interaction and level design through independent games.' }, tech: { zh: '计算机科学 · 软件开发', en: 'Computer science · Software development' } },
];
const skills = [
  { title: { zh: '程序与引擎', en: 'Programming & engines' }, body: { zh: 'C++、C#、Direct3D 11、节点与资源系统、脚本桥接和编辑器开发。', en: 'C++, C#, Direct3D 11, node and resource systems, script integration and editor development.' } },
  { title: { zh: '设计与技术美术', en: 'Design & technical art' }, body: { zh: 'Godot、Unity、Unreal Engine、光学交互、Shader、PCG 工具与关卡实践。', en: 'Godot, Unity, Unreal Engine, optical interaction, shaders, PCG tools and level-design practice.' } },
  { title: { zh: '教学与协作', en: 'Teaching & collaboration' }, body: { zh: 'PICO-8 入门培训、跟随操作、代码讲解、课后答疑与游戏社项目实践。', en: 'PICO-8 training, live coding, code explanation, follow-up Q&A and game-club project practice.' } },
];
---
<PortfolioLayout>
  <section class="hero hero-intro" id="intro">
    <div class="hero-copy">
      <Text as="p" class="eyebrow" zh="周尚礼 · 游戏开发与教学" en="ShangLi Zhou · Game development & teaching" />
      <Text as="h1" class="hero-title" zh="你好，我是周尚礼" en="Hi, I'm ShangLi Zhou" />
      <Text as="p" class="subtitle" zh="用技术实现想法，用游戏表达体验。" en="Building ideas with technology; expressing experiences through games." />
      <Text as="p" class="hero-intro-text" zh="我以游戏程序为基础，参与技术美术与游戏设计。目前就读于 SMU Guildhall，关注引擎开发、可玩的系统，以及如何帮助更多人开始制作游戏。" en="My foundation is game programming, with practice in technical art and game design. At SMU Guildhall, I focus on engine development, playable systems and helping others begin making games." />
      <p class="contact-line"><Text zh="联系邮箱：" en="Email: " /><a href="mailto:185600557@qq.com">185600557@qq.com</a></p>
    </div>
    <figure class="hero-portrait">
      <Image class="profile-image" src={HeroImage} alt="周尚礼的头像照片" data-i18n-inline-alt data-zh="周尚礼的头像照片" data-en="Portrait of ShangLi Zhou" format="webp" quality={82} widths={[320,480,720]} sizes="(max-width: 600px) 226px, 300px" loading="eager" fetchpriority="high" />
      <figcaption>周尚礼 / SHANGLI ZHOU</figcaption>
    </figure>
  </section>
  <div id="projects">
  {(['personal','team'] as const).map((category) => <section class="section showcase-section" id={category === 'personal' ? 'personal-projects' : 'team-projects'}>
    <div class="section-heading"><Text as="h2" zh={category === 'personal' ? '个人项目' : '团队项目'} en={category === 'personal' ? 'Personal projects' : 'Team projects'} /><a href="/projects/"><Text zh="全部项目 →" en="All projects →" /></a></div>
    <div class="showcase-list">{getProjectsByCategory(category).map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>)}
  </div>
  <section class="section" id="articles"><div class="section-heading"><Text as="h2" zh="技术研究与开发笔记" en="Studies & development notes" /><a href="/articles/"><Text zh="全部文章 →" en="All articles →" /></a></div><div class="reading-grid">{selectedArticles.map((pair) => pair && <ContentCard pair={pair} />)}</div></section>
  <section class="section" id="teaching"><div class="section-heading"><Text as="h2" zh="教学与社群实践" en="Teaching & community" /><a href="/teaching/"><Text zh="课程与作品展 →" en="Courses & submissions →" /></a></div><div class="reading-grid">{selectedTeaching.map((pair) => pair && <ContentCard pair={pair} />)}</div></section>
  <section class="section about-profile" id="about">
    <Text as="p" class="section-label" zh="个人介绍与经历" en="About & experience" />
    <Text as="h2" zh="从底层系统到游戏体验" en="From underlying systems to playable experiences" />
    <div class="about-profile-grid">
      <div class="copy-block bio-copy">
        <Text as="p" zh="我本科就读于上海科技大学计算机科学专业，目前在 SMU Guildhall 学习游戏开发，预计于 2027 年 5 月毕业。我使用 C++ 开发 Ming 引擎，也在 Godot、Unity 和 Unreal Engine 中参与独立与团队游戏制作。" en="I studied computer science at ShanghaiTech University and now study game development at SMU Guildhall, with graduation expected in May 2027. I develop the Ming engine in C++ and work on independent and team games in Godot, Unity and Unreal Engine." />
        <Text as="p" zh="我的专业基础是程序，但我希望理解制作一款游戏所需要的整体判断：玩法为什么成立，视觉如何传达规则，工具怎样支持团队，以及应该把有限时间投入哪里。长期而言，我希望成长为能够连接这些工作的游戏制作人。" en="Programming is my foundation, but I want to understand the decisions behind a complete game: why a mechanic works, how visuals communicate rules, how tools support a team and where limited production time should go. In the long term, I hope to grow into a producer who connects these responsibilities." />
        <Text as="p" zh="我也面向游戏社新成员主讲 PICO-8 开发入门课程，通过讲解、跟随操作、答疑和习题帮助大家开始创作。课程后的一周 Game Jam 为同学们提供了实践与展示作品的机会。" en="I also teach introductory PICO-8 development to new game-club members through explanations, live coding, Q&A and exercises. A subsequent one-week game jam offered participants an opportunity to practice and share their work." />
        <Text as="p" zh="在程序之外，我学习关卡设计，写过《奥日与萤火意志》和《蔚蓝》的关卡拆解，也复刻过《神秘海域4》的关卡，以理解节奏、空间、移动路径和遭遇设计。" en="Beyond programming, I study level design. I have written breakdowns of Ori and the Will of the Wisps and Celeste, and recreated a level from Uncharted 4 to study pacing, space, traversal and encounter design." />
      </div>
    </div>
    <div class="skills-grid">{skills.map((skill) => <div class="skill-item"><Text as="h3" {...skill.title} /><Text as="p" {...skill.body} /></div>)}</div>
  </section>
  {[{ id: 'experience', title: { zh: '实习经历', en: 'Industry experience' }, entries: experiences }, { id: 'education', title: { zh: '教育经历', en: 'Education' }, entries: education }].map((group) => <section class="section timeline-section" id={group.id}>
    <Text as="h2" {...group.title} />
    <div class="timeline-list">{group.entries.map((entry) => <article class="timeline-item">
      <div class="timeline-media"><Image src={entry.image} alt={entry.name.zh} data-i18n-inline-alt data-zh={entry.name.zh} data-en={entry.name.en} width={420} format="webp" quality={84} loading="lazy" /></div>
      <div class="timeline-meta"><Text as="p" class="timeline-date" {...entry.date} /><Text as="h3" {...entry.name} /><Text as="p" {...entry.role} /></div>
      <div class="timeline-copy"><Text as="p" {...entry.description} /><Text as="p" class="timeline-tech" {...entry.tech} /></div>
    </article>)}</div>
  </section>)}
	<section class="section interests-section" id="interests">
		<p class="section-label" data-i18n-inline data-en="Personal Interests" data-zh="个人兴趣">个人兴趣</p>
		<h2 data-i18n-inline data-en="Beyond Game Development" data-zh="游戏开发之外">游戏开发之外</h2>
		<div class="interests-grid">
			<figure class="interests-media">
				<Image
					src={DesktopImage}
					alt="周尚礼摆放着高达模型和书籍的书桌"
					data-i18n-inline-alt
					data-en="ShangLi Zhou's desk with Gundam models and books"
					data-zh="周尚礼摆放着高达模型和书籍的书桌"
					format="webp"
					quality={84}
					widths={[480, 720, 960]}
					sizes="(max-width: 860px) 100vw, 45vw"
				/>
				<figcaption
					data-i18n-inline
					data-en="My desk, surrounded by models, books, and everyday sources of inspiration."
					data-zh="我的书桌，以及陪伴我创作的模型、书籍和日常灵感。">我的书桌，以及陪伴我创作的模型、书籍和日常灵感。</figcaption>
			</figure>
			<div class="copy-block interests-copy">
				<p
					data-i18n-inline
					data-en="Model building is one of my favorite hands-on creative hobbies. The PG Banshee in the upper right and the Sazabi in the upper left reflect that interest. When I graduated, I built different Gundam kits for several friends and hand-painted them with battle damage and weathering effects."
					data-zh="模型制作是我很喜欢的一项动手创作爱好。图片右上角是 PG 报丧女妖，左上角是沙扎比。毕业时，我也为几位朋友分别制作了不同的高达模型，并通过笔涂加入战损和做旧效果。">模型制作是我很喜欢的一项动手创作爱好。图片右上角是 PG 报丧女妖，左上角是沙扎比。毕业时，我也为几位朋友分别制作了不同的高达模型，并通过笔涂加入战损和做旧效果。</p>
				<p
					data-i18n-inline
					data-en="I enjoy reading history and social science, with a particular interest in modern Chinese history. Reading gives me another way to understand people, society, and the historical forces behind change."
					data-zh="我喜欢阅读历史与社会科学类书籍，尤其对中国近现代史有较多兴趣。阅读也让我能够从另一个角度理解人物、社会，以及历史变化背后的力量。">我喜欢阅读历史与社会科学类书籍，尤其对中国近现代史有较多兴趣。阅读也让我能够从另一个角度理解人物、社会，以及历史变化背后的力量。</p>
				<p
					data-i18n-inline
					data-en="I also enjoy literature, film, and other art forms. They not only inspire my creative work, but also shape the way I understand games."
					data-zh="我也喜欢接触文学、影视与其他艺术形式。它们不仅为我的创作提供灵感，也影响了我理解游戏的方式。">我也喜欢接触文学、影视与其他艺术形式。它们不仅为我的创作提供灵感，也影响了我理解游戏的方式。</p>

				<p
					data-i18n-inline
					data-en="I see games as an interactive medium, and I often bring critical approaches from literature and film into the way I understand them. Whether a work reaches us through words, images, interactive devices, or future brain-computer interfaces, art ultimately returns to the human heart, awakening emotions that are widely shared yet easily forgotten."
					data-zh="我更愿意把游戏视为一种交互式媒介，也习惯借用文学与影视的批评方法去理解它。无论媒介是文字、图像、交互设备，还是未来可能出现的脑机接口，文艺最终都要回到人的心中，唤起那些普遍存在、却常被匆匆遗忘的情感。">我更愿意把游戏视为一种交互式媒介，也习惯借用文学与影视的批评方法去理解它。无论媒介是文字、图像、交互设备，还是未来可能出现的脑机接口，文艺最终都要回到人的心中，唤起那些普遍存在、却常被匆匆遗忘的情感。</p>
				<p
					data-i18n-inline
					data-en="If physics continually asks what the smallest unit of the world might be, then the smallest unit of art is always the human being. It is precisely because something in human nature remains unchanged that we can find resonance across literature, film, and games; between history and the present, China and elsewhere, self and other, the individual and the world. Living in an age of rapid political and technological change, I try to understand where I stand, who I have become, and where I am going. These are the things I hope to find in games—and ultimately express through them."
					data-zh="如果说物理学不断追问构成世界的最小单位，那么文艺的最小单位始终是人。正因为人的不变性，我们才能在文学、影视与游戏之间，在历史与当下、中国与外国、自我与他者、个人与世界之间，找到一种共鸣。我正处于一个政治和科技都急剧变化的时代，我试图理解自己身处何处、成为了怎样的人，又将走向哪里。这正是我希望在游戏中寻找，并最终通过游戏传达的东西。">如果说物理学不断追问构成世界的最小单位，那么文艺的最小单位始终是人。正因为人的不变性，我们才能在文学、影视与游戏之间，在历史与当下、中国与外国、自我与他者、个人与世界之间，找到一种共鸣。我正处于一个政治和科技都急剧变化的时代，我试图理解自己身处何处、成为了怎样的人，又将走向哪里。这正是我希望在游戏中寻找，并最终通过游戏传达的东西。</p>
			</div>
		</div>
	</section>
</PortfolioLayout>
