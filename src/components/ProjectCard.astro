---
import Text from './Text.astro';
import type { Project } from '../data/projects';
interface Props { project: Project; index?: number; }
const { project, index } = Astro.props;
---
<a class="project-row" href={'/projects/' + project.slug} data-project-row>
  <div class="project-row-backdrop" aria-hidden="true"><img src={project.media.src} alt="" loading="lazy" decoding="async" /></div>
  <span class="project-row-number" aria-hidden="true">{index === undefined ? '—' : String(index + 1).padStart(2, '0')}</span>
  <div class="project-row-copy">
    <Text as="p" class="eyebrow" zh={project.category === 'personal' ? '个人作品' : '团队作品'} en={project.category === 'personal' ? 'Personal work' : 'Team work'} />
    <h3>{project.title}</h3>
    <Text as="p" class="project-summary" {...project.summary} />
    <Text as="p" class="showcase-tech" {...project.tech} />
  </div>
  <span class="project-row-arrow" aria-hidden="true">↗</span>
</a>
