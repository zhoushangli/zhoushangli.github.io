---
import Text from './Text.astro';
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---
<a class="showcase-card clickable-card" href={`/projects/${project.slug}`}>
	<div class={`showcase-media ${project.slug === 'spectrex' ? 'icon-media' : ''}`}>
		<img src={project.media.src} alt={project.media.alt.zh} loading="lazy" data-i18n-inline-alt data-zh={project.media.alt.zh} data-en={project.media.alt.en} />
	</div>
	<div class="showcase-copy">
		<h3>{project.title}</h3>
		<Text as="p" {...project.summary} />
		<Text as="p" class="showcase-tech" {...project.tech} />
	</div>
</a>
