---
import Shell from './Shell.astro';
import ArticleBody from './ArticleBody.astro';
import Entries from './Entries.astro';
import Filters from './Filters.astro';
import type { DesignProps } from '../../data/design-content';
const { concept, view, base, data } = Astro.props as DesignProps;
---
<Shell concept={concept} view={view}>
  <header class="theatre-header"><span class="micro">THE MAKING OF WORLDS</span><a class="brand" href={base + '/home'}>周尚礼 · 制作剧场</a><nav class="nav-links" aria-label="主导航"><a href={base + '/home'} aria-current={view === 'home' ? 'page' : undefined}>开场</a><a href={base + '/articles'} aria-current={view === 'articles' ? 'page' : undefined}>节目单</a><a href={base + '/article'} aria-current={view === 'article' ? 'page' : undefined}>幕后</a></nav></header>
  <main id="main-content" class="theatre-main">
    {view === 'home' && <>
      <section class="theatre-overture"><img class="theatre-backdrop" src={data.projects[1].media.src} alt={data.projects[1].media.alt.zh} /><div class="theatre-overture-copy"><p class="eyebrow">OVERTURE / 创作的开场</p><h1>世界登场之前，<br /><em>先有一个想法。</em></h1><p>游戏开发、技术研究，以及幕后的制作故事。</p><a class="action" href="#projects">展开这一幕 ↓</a></div><span class="theatre-caption micro">开场作品 / {data.projects[1].title}</span></section>
      <section class="theatre-programme" id="projects"><div class="section-title"><p class="eyebrow">THE PROGRAMME</p><h2>作品，分幕呈现。</h2></div>{data.projects.map((project, index) => <details class="theatre-act" open={index === 0}><summary><span class="micro">ACT / 0{index + 1}</span><h3>{project.title}</h3><span class="act-toggle" aria-hidden="true">＋</span></summary><div class="theatre-act-body"><img src={project.media.src} alt={project.media.alt.zh} loading="lazy" /><div><p class="lede">{project.summary.zh}</p><a class="action" href={'/projects/' + project.slug + '/'}>前往正式项目 ↗</a></div></div></details>)}</section>
      <section class="theatre-writing"><div class="section-title"><p class="eyebrow">BEHIND THE SCENES</p><h2>幕后的文字</h2></div><Entries data={data} base={base} limit={3} /></section>
    </>}
    {view === 'articles' && <><header class="theatre-page-head"><p class="eyebrow">THE READING PROGRAMME</p><h1>每一幕，<br />都有值得追问的细节。</h1><p class="lede">按研究主题展开节目单。</p></header><div class="theatre-index"><Filters data={data} />{data.categories.map((category, index) => <details class="theatre-act" open><summary><span class="micro">主题 / 0{index + 1}</span><h2>{category.label}</h2><span class="act-toggle" aria-hidden="true">＋</span></summary><Entries data={{ ...data, articles: data.articles.filter((item) => item.category === category.id) }} base={base} /></details>)}</div></>}
    {view === 'article' && <><header class="theatre-page-head"><p class="eyebrow">BEHIND THE SCENES / 图形渲染</p><h1 class="article-title">{data.sample.title}</h1><p class="article-deck">{data.sample.description}</p></header><div class="theatre-reading"><aside class="theatre-act-nav"><p class="eyebrow">幕次 / CONTENTS</p><nav class="toc" aria-label="文章目录">{data.headings.map((heading, index) => <a href={'#' + heading.slug}><span>ACT {String(index + 1).padStart(2, '0')}</span>{heading.text}</a>)}</nav></aside><ArticleBody data={data} /></div></>}
  </main>
</Shell>
<script>
  document.querySelectorAll<HTMLButtonElement>('.theatre-index [data-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLDetailsElement>('.theatre-index .theatre-act').forEach((group) => {
        group.hidden = !group.querySelector('[data-entry]:not([hidden])');
        if (!group.hidden) {
          group.open = true;
        }
      });
    });
  });
</script>
