---
import Text from './Text.astro';
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
const path = Astro.url.pathname;
const home = path === '/';
const links = [
  { href: '/', number: 'I.', zh: '首页序言', en: 'Home', active: home },
  { href: '/projects/', number: 'II.', zh: '项目作品', en: 'Projects', active: path.startsWith('/projects') },
  { href: '/articles/', number: 'III.', zh: '研究与笔记', en: 'Studies & notes', active: path.startsWith('/articles') },
  { href: '/teaching/', number: 'IV.', zh: '教学与社群', en: 'Teaching', active: path.startsWith('/teaching') },
  { href: '/#about', number: 'V.', zh: '个人经历', en: 'About & experience', active: false },
];
const chapters = [
  { href: '#projects', zh: '一 / 选定作品', en: '01 / Selected works' },
  { href: '#articles', zh: '二 / 近期文字', en: '02 / Recent writing' },
  { href: '#teaching', zh: '三 / 教学实践', en: '03 / Teaching' },
  { href: '#about', zh: '四 / 个人经历', en: '04 / About' },
  { href: '#interests', zh: '五 / 个人兴趣', en: '05 / Beyond games' },
];
---
<header class="site-sidebar">
  <a class="site-brand" href="/"><span class="brand-seal" aria-hidden="true">周</span><Text zh="周尚礼" en="ShangLi Zhou" /></a>
  <Text as="p" class="sidebar-description" zh="游戏开发 · 研究 · 教学" en="Game development · Studies · Teaching" />
  <details class="site-menu" open>
    <summary><Text zh="站点目录" en="Contents" /><span aria-hidden="true">＋</span></summary>
    <nav class="site-navigation" aria-label="主导航" data-i18n-inline-aria-label data-zh="主导航" data-en="Main navigation">
      {links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}><span class="nav-number" aria-hidden="true">{link.number}</span><Text zh={link.zh} en={link.en} /></a>)}
    </nav>
    {home && <nav class="home-chapters" aria-label="首页章节" data-i18n-inline-aria-label data-zh="首页章节" data-en="Home chapters">
      {chapters.map((link) => <a href={link.href} data-chapter-link><Text zh={link.zh} en={link.en} /></a>)}
    </nav>}
  </details>
  <div class="sidebar-bottom">
    <Text as="p" class="sidebar-note" zh="写下实现的过程，\n也留下思考的余地。" en="Notes on making,\nand room for thought." />
    <div class="sidebar-social"><a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub ↗</a><a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn ↗</a></div>
    <button class="language-toggle" type="button" data-language-toggle aria-label="切换为英文"><span class="language-mark" aria-hidden="true"></span><span data-language-label>EN</span></button>
  </div>
</header>
<script is:inline>
  (() => {
    const menu = document.querySelector('.site-menu');
    const mobile = matchMedia('(max-width: 900px)');
    const update = () => { menu.open = !mobile.matches; };
    update();
    mobile.addEventListener('change', update);
    menu.addEventListener('click', (event) => {
      if (mobile.matches && event.target instanceof Element && event.target.closest('a')) {
        menu.open = false;
      }
    });
  })();
</script>
<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]');
  if (links.length) {
    const positions = Array.from(links).map((link) => ({
      link,
      section: document.querySelector<HTMLElement>(link.getAttribute('href')!),
    }));
    const update = () => {
      const reached = positions.filter(({ section }) => section && section.getBoundingClientRect().top <= innerHeight * .35);
      const current = reached.at(-1)?.link;
      positions.forEach(({ link }) => {
        if (link === current) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
