---
import Text from './Text.astro';
import { gamejamSubmissions } from '../data/gamejam';
---
<section class="section" id="gamejam-gallery">
	<Text as="h2" zh="作品展示" en="Gallery" />
	<Text as="p" class="caption" zh="以下展示活动中留存的作品封面，作品属于各自创作者。" en="Covers retained from the game jam. The games belong to their respective creators." />
	<div class="gamejam-grid">
		{gamejamSubmissions.map((submission) => <article class="gamejam-card">
			<img src={submission.cover} alt={`${submission.title} 卡带封面`} data-i18n-inline-alt data-zh={`${submission.title} 卡带封面`} data-en={`${submission.title} cartridge cover`} loading="lazy" width="160" height="205" />
			<h3>{submission.title}</h3>
		</article>)}
	</div>
</section>
