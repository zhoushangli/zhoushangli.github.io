---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/reading.css';

interface Props {
  title?: string | { zh: string; en: string };
  description?: string | { zh: string; en: string };
}
const { title = { zh: SITE_TITLE, en: 'ShangLi Zhou · Game development & teaching' }, description = { zh: SITE_DESCRIPTION, en: 'Game programming, technical art, game design and teaching by ShangLi Zhou.' } } = Astro.props;
const titles = typeof title === 'string' ? { zh: title, en: title } : title;
const descriptions = typeof description === 'string' ? { zh: description, en: description } : description;
---
<!doctype html>
<html lang="zh-CN" data-theme="dark" data-title-zh={titles.zh} data-title-en={titles.en} data-description-zh={descriptions.zh} data-description-en={descriptions.en}>
  <head>
    <script is:inline>
      (() => {
        let language = 'zh';
        let theme = 'dark';
        try {
          if (localStorage.getItem('portfolio-language') === 'en') { language = 'en'; }
          if (localStorage.getItem('portfolio-theme') === 'light') { theme = 'light'; }
        } catch {}
        document.documentElement.dataset.language = language;
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <style is:inline>
      html[data-language='en'] body:not([data-language-ready]) { visibility: hidden; }
    </style>
    <BaseHead title={titles.zh} description={descriptions.zh} />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let language = root.dataset.language === 'en' ? 'en' : 'zh';
        let theme = root.dataset.theme === 'light' ? 'light' : 'dark';

        function save(key, value) {
          try { localStorage.setItem(key, value); } catch {}
        }

        function applyTheme(nextTheme) {
          theme = nextTheme === 'light' ? 'light' : 'dark';
          root.dataset.theme = theme;
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            const label = language === 'zh'
              ? (theme === 'dark' ? '切换为浅色主题' : '切换为深色主题')
              : (theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
            button.setAttribute('aria-label', label);
          });
          document.querySelectorAll('[data-theme-toggle-icon]').forEach((icon) => {
            icon.textContent = theme === 'dark' ? '☀' : '☾';
          });
        }

        function applyLanguage(nextLanguage) {
          language = nextLanguage === 'en' ? 'en' : 'zh';
          root.lang = language === 'zh' ? 'zh-CN' : 'en';
          root.dataset.language = language;
          document.querySelectorAll('[data-i18n-inline]').forEach((element) => {
            element.textContent = element.getAttribute(`data-${language}`) ?? '';
          });
          document.querySelectorAll('[data-i18n-inline-html]').forEach((element) => {
            element.innerHTML = element.getAttribute(`data-${language}`) ?? '';
          });
          ['alt', 'title', 'aria-label'].forEach((attribute) => {
            document.querySelectorAll(`[data-i18n-inline-${attribute}]`).forEach((element) => {
              element.setAttribute(attribute, element.getAttribute(`data-${language}`) ?? '');
            });
          });
          document.querySelectorAll('[data-language-block]').forEach((block) => {
            const inactive = block.getAttribute('data-language-block') !== language;
            block.hidden = inactive;
            block.inert = inactive;
          });
          document.querySelectorAll('[data-language-toggle]').forEach((button) => {
            button.setAttribute('aria-label', language === 'zh' ? '切换为英文' : 'Switch to Chinese');
          });
          document.querySelectorAll('[data-language-label]').forEach((label) => {
            label.textContent = language === 'zh' ? 'EN' : '中文';
          });
          const title = root.getAttribute(`data-title-${language}`) ?? '';
          const description = root.getAttribute(`data-description-${language}`) ?? '';
          document.title = title;
          document.querySelectorAll('meta[name="title"], meta[property="og:title"], meta[property="twitter:title"]').forEach((meta) => meta.setAttribute('content', title));
          document.querySelectorAll('meta[name="description"], meta[property="og:description"], meta[property="twitter:description"]').forEach((meta) => meta.setAttribute('content', description));
          applyTheme(theme);
          document.body.setAttribute('data-language-ready', '');
        }

        window.setPortfolioLanguage = (value) => {
          save('portfolio-language', value === 'en' ? 'en' : 'zh');
          applyLanguage(value);
        };
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) { return; }
          if (event.target.closest('[data-language-toggle]')) {
            window.setPortfolioLanguage(language === 'zh' ? 'en' : 'zh');
          }
          if (event.target.closest('[data-theme-toggle]')) {
            const nextTheme = theme === 'dark' ? 'light' : 'dark';
            save('portfolio-theme', nextTheme);
            applyTheme(nextTheme);
          }
        });
        try {
          applyLanguage(language);
        } finally {
          // Never leave the page hidden if a language-dependent step throws.
          document.body.setAttribute('data-language-ready', '');
        }
      })();
    </script>
  </body>
</html>
